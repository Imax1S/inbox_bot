# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
# Comma-separated list of allowed user IDs
TELEGRAM_USER_IDS=your_telegram_user_id_1,your_telegram_user_id_2

# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# Per-agent model overrides (optional — defaults: Sonnet for all agents)
# Anthropic: claude-sonnet-4-5-20250929, claude-opus-4-6, claude-haiku-4-5-20251001
# OpenAI: gpt-4.1-mini (fast), gpt-4.1 (quality)
# COLLECTOR_MODEL=claude-sonnet-4-5-20250929
# CLUSTERER_MODEL=claude-sonnet-4-5-20250929
# RESEARCHER_MODEL=claude-sonnet-4-5-20250929
# WRITER_MODEL=claude-sonnet-4-5-20250929
# EDITOR_MODEL=claude-sonnet-4-5-20250929
# TRANSLATOR_MODEL=claude-sonnet-4-5-20250929

# Obsidian Vault Path
OBSIDIAN_VAULT_PATH=/vault/life/weekly

# Database
# DB_PATH=data/digest.db

# Digest length control (target read time in minutes)
# TARGET_READ_MINUTES=25

# Schedule (Sunday 23:00 Berlin time by default)
# SCHEDULE_ENABLED=true
# SCHEDULE_DAY=6
# SCHEDULE_HOUR=23
# SCHEDULE_MINUTE=0
# SCHEDULE_TIMEZONE=Europe/Berlin
